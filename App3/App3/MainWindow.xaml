        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:App3"
        mc:Ignorable="d"
        Title="Application three" Height="450" Width="800">
    <Grid>
       
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Width="120" Height="30" x:Name="sqlClick" Click="sqlClick_Click" Content="MySql" Margin="10"/>
            <Button Width="120" Height="30" x:Name="PostgreClick" Click="PostgreClick_Click" Content="PostgreSql"/>
        </StackPanel>
        
        
    </Grid>
</Window>
