<Window x:Class="AppFive.PostgreSql"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppFive"
        mc:Ignorable="d"
        Title="PostgreSql" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="sqlBt" Width="120" Click="sqlBt_Click" Content="SQL" Margin="10"/>
            <Button x:Name="linqBt" Width="120" Click="linqBt_Click" Content="Linq" Margin="10"/>
            <Button x:Name="exitBt" Width="120" Click="exitBt_Click" Content="Выход" Margin="10"/>
        </StackPanel>
        <StackPanel x:Name="linqQuery" Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1">
                <ComboBox x:Name="fioScientCb" SelectionChanged="fioScientCb_SelectionChanged" Width="120" Height="30" Margin="10"/>
                <ComboBox x:Name="nameDirectCb" SelectionChanged="fioScientCb_SelectionChanged" Width="120" Height="30" Margin="10"/>
            </StackPanel>
            <ScrollViewer>
                <ListBox x:Name="linqGrid" Height="350">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <local:UserControlOne DataContext="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </StackPanel>
        <StackPanel x:Name="sqlQuery" Grid.Row="2" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1">
                <ComboBox x:Name="SQLfioScientCb" SelectionChanged="SQLfioScientCb_SelectionChanged" Width="120" Height="30" Margin="10"/>
                <ComboBox x:Name="SQLnameDirectCb" SelectionChanged="SQLfioScientCb_SelectionChanged" Width="120" Height="30" Margin="10"/>
            </StackPanel>
            <ScrollViewer Height="350">
                <ListBox x:Name="sqlGrid">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <local:UserControlOne DataContext="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>
