<UserControl x:Class="AppFive.UserControlOne"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppFive"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Margin="10" Padding="10" Background="LightYellow">
            <StackPanel Orientation="Horizontal">
                <Border Width="100" Height="100" Background="LightGray" CornerRadius="5" Margin="0,0,10,0">
                    <TextBlock Text="📄" FontSize="48" TextAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                </Border>
                <StackPanel Width="400">
                    <TextBlock x:Name="nameGrantTb" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                    <TextBlock x:Name="fioScientTb" Margin="0,2"/>
                    <TextBlock x:Name="directNameTb" Margin="0,2"/>
                    <TextBlock x:Name="dateStartTb" Margin="0,2"/>
                    <TextBlock x:Name="dateEndTb" Margin="0,2"/>
                    <TextBlock x:Name="organizationTb" Margin="0,2"/>
                </StackPanel>
                <Border  CornerRadius="5" Padding="10" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="summaTb" FontWeight="Bold" FontSize="16" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
